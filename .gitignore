### Astro / VitePress 构建产物 ###
# 不带前导斜杠的 dist/ 匹配任意层级，所以 docs/.vitepress/dist/ 不必单列
dist/
.astro/
.vercel/

# VitePress 缓存（docs/ 在本仓库里只是内容源，theme/ 与 config 才是源码）
docs/.vitepress/cache/

### 构建时生成，不入库 ###
# 由 docs/ 里的引用按需铺开（图片本体已在 docs/ 内跟踪，约 787MB）
public/docassets/
.docassets-manifest.json

# Astro 内容集合：由 npm run migrate 从 docs/ 生成
src/content/docs/

# 本地 npm 缓存（npm 全局缓存在沙箱里不可写）
.npm-cache/

### Node ###
# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# dependencies
node_modules/

# environment variables
.env
.env.production

### 编辑器 / 系统 ###
# Vim
[._]*.un~

# VisualStudioCode
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Code workspace files
*.code-workspace

# macOS
.DS_Store

### Custom ###
old_blog
ignore.*
bunfig.toml
/src/content/blog/test.*
/test/
