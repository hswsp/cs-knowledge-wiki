---
/**
 * Section cards for the /docs landing page.
 *
 * Replaces the theme's hardcoded three-category map with the sections that
 * actually exist in this knowledge base, showing live doc counts and the first
 * few entries ordered by the curated `order` frontmatter.
 */
import { type CollectionEntry } from 'astro:content'

import { getBlogCollection } from 'astro-pure/server'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import { sectionMeta, sortSections } from '@/utils/sections'

export const prerender = true
export const partial = true

const docs = (await getBlogCollection('docs')) as CollectionEntry<'docs'>[]


const bySection = new Map<string, CollectionEntry<'docs'>[]>()
for (const doc of docs) {
  const section = doc.id.split('/')[0]
  if (!bySection.has(section)) bySection.set(section, [])
  bySection.get(section)!.push(doc)
}

const sections = sortSections([...bySection.keys()])

type Props = {
  class?: string
  title?: boolean
  layout?: 'grid' | 'list'
  limit?: number
}

const { class: className, title = true, layout = 'list', limit = 6, ...props } = Astro.props
---

<docs-toc class={cn('not-prose', className, layout === 'grid' ? 'grid-layout w-full' : 'list-layout')} {...props}>
  <div class='mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full items-stretch'>
    {
      sections.map((section) => {
        const meta = sectionMeta(section)
        const entries = bySection
          .get(section)!
          .slice()
          .sort(
            (a, b) =>
              (a.data.order ?? 999) - (b.data.order ?? 999) ||
              a.data.title.localeCompare(b.data.title, 'zh')
          )
        const shown = entries.slice(0, limit)
        return (
          <div class='group relative flex flex-col h-full gap-y-3 rounded-2xl border bg-background/50 p-6 shadow-sm transition-all hover:shadow-md hover:border-primary/50 overflow-hidden'>
            <div class='absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-transparent via-primary/30 to-transparent opacity-0 transition-opacity group-hover:opacity-100' />
            <a class='flex items-center gap-x-3 mb-1 no-underline' href={`/docs/${section}/`}>
              <div class='flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary/20'>
                <Icon name={meta.icon} class='size-5' />
              </div>
              <h3 class='text-lg font-semibold tracking-tight text-foreground'>{meta.title}</h3>
              <span class='ml-auto text-xs text-muted-foreground tabular-nums'>{entries.length}</span>
            </a>

            <p class='text-sm text-muted-foreground mb-1 line-clamp-2'>{meta.desc}</p>

            <ul class='flex flex-col gap-y-1.5 flex-1 list-none m-0 p-0'>
              {shown.map((doc) => (
                <li class='relative flex items-center'>
                  <Icon
                    name='document'
                    class='size-3 me-2 text-muted-foreground opacity-50 transition-transform'
                  />
                  <a
                    class='flex-1 truncate text-sm text-foreground/80 transition-colors hover:text-primary no-underline'
                    href={`/docs/${doc.id}/`}
                  >
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>

            {entries.length > shown.length && (
              <a class='docs-more text-xs text-primary no-underline' href={`/docs/${section}/`}>
                查看全部 {entries.length} 篇 →
              </a>
            )}
          </div>
        )
      })
    }
  </div>
</docs-toc>

<style>
  docs-toc .docs-more:hover {
    text-decoration: underline;
  }
</style>
