---
/**
 * Section landing page: /docs/<section>
 *
 * The docs collection stores one file per directory, so without this route
 * `/docs/math` would 404 and users would be sent to `/docs/math/index`.
 * Data loading happens inside getStaticPaths because Astro extracts it into a
 * separate bundle where component-scope variables are not available.
 */
import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import DocsTree from '@/components/docs/DocsTree.astro'
import { buildSectionTree, sectionMeta, sortSections, type TreeNode } from '@/utils/sections'

export const prerender = true

export async function getStaticPaths() {
  const docs = await getBlogCollection('docs')
  const sections = sortSections([...new Set(docs.map((d) => d.id.split('/')[0]))])
  return sections.map((section) => ({
    params: { section },
    props: {
      section,
      tree: buildSectionTree(docs as any, section),
      count: docs.filter((d) => d.id.startsWith(`${section}/`)).length
    }
  }))
}

type Props = { section: string; tree: TreeNode; count: number }

const { section, tree, count } = Astro.props
const meta = sectionMeta(section)
---

<PageLayout meta={{ title: meta.title, description: meta.desc || `${meta.title} notes` }}>
  <main class='mt-6 lg:mt-10 w-full max-w-4xl mx-auto px-4 pb-16'>
    <div class='animate mb-8 rounded-2xl border bg-muted/30 px-6 py-6 shadow-sm'>
      <div class='flex items-center gap-3'>
        <h1 class='text-3xl font-bold tracking-tight text-foreground'>{meta.title}</h1>
        <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
          {count} 篇
        </span>
      </div>
      {meta.desc && <p class='mt-3 text-sm leading-6 text-muted-foreground'>{meta.desc}</p>}
      <a class='mt-4 inline-block text-sm text-primary no-underline hover:underline' href='/docs'>
        ← 返回知识库总览
      </a>
    </div>

    <section class='animate rounded-2xl border bg-background/50 p-6'>
      <DocsTree node={tree} depth={0} />
    </section>
  </main>
</PageLayout>
