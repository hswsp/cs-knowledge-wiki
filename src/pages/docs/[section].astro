---
/**
 * 学科入口页：/docs/<section>
 *
 * 与 /categories/<section> 共用分类数据与渲染，保证两处入口一致。
 */
import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import CategoryTree from '@/components/docs/CategoryTree.astro'
import { buildCategoryTree, type DocEntry } from '@/utils/docs-categories'

export const prerender = true

export async function getStaticPaths() {
  const docs = (await getBlogCollection('docs')) as DocEntry[]
  const nodes = buildCategoryTree(docs)
  return [...nodes.values()]
    .filter((node) => node.depth === 1)
    .map((node) => ({
      params: { section: node.path },
      props: { path: node.path }
    }))
}

const { path } = Astro.props as { path: string }

const docs = (await getBlogCollection('docs')) as DocEntry[]
const nodes = buildCategoryTree(docs)
const node = nodes.get(path)!

const meta = { title: node.label, description: node.desc || `${node.label}：${node.total} 篇笔记` }
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10 w-full max-w-4xl mx-auto px-4 pb-16'>
    <div class='animate mb-8 rounded-2xl border bg-muted/30 px-6 py-6 shadow-sm'>
      <div class='flex items-center gap-3'>
        <h1 class='text-3xl font-bold tracking-tight text-foreground'>{node.label}</h1>
        <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
          {node.total} 篇
        </span>
      </div>
      {node.desc && <p class='mt-3 text-sm leading-6 text-muted-foreground'>{node.desc}</p>}
      <a class='mt-4 inline-block text-sm text-primary no-underline hover:underline' href='/categories'>
        ← 全部分类
      </a>
    </div>

    <section class='animate rounded-2xl border bg-background/50 p-6'>
      <CategoryTree node={node} nodes={nodes} depth={0} />
    </section>
  </main>
</PageLayout>
