---
/**
 * 分类总览：知识库的学科层（大分类）。
 *
 * 分类直接由内容路径推导（与主题的 blog 分类同一套思路），
 * 入口顺序沿用旧 VitePress 首页的学科顺序。
 */
import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import KnowledgeIndexHero from '@/components/KnowledgeIndexHero.astro'
import {
  buildCategoryTree,
  categoryDesc,
  topLevelCategories,
  type DocEntry,
  categoryHref
} from '@/utils/docs-categories'

export const prerender = true

const docs = (await getBlogCollection('docs')) as DocEntry[]
const nodes = buildCategoryTree(docs)
const tops = topLevelCategories(nodes)

const meta = {
  title: '分类',
  description: '按学科浏览 CS 知识库：数学、算法、机器学习、存储、系统设计等'
}
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10 w-full max-w-6xl mx-auto px-4 pb-20'>
    <KnowledgeIndexHero
      icon='list'
      eyebrow='知识库'
      title='按分类浏览'
      description='学科 → 二级分类 → 文章。也可以直接用顶部搜索。'
      stats={[
        { label: '学科', value: tops.length },
        { label: '笔记', value: docs.length }
      ]}
      statsLabel='知识库概览'
      symbol='分类'
    />

    <div class='mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3'>
      {
        tops.map((node) => (
          <a
            href={categoryHref(node.path)}
            class='group relative flex flex-col gap-2 rounded-2xl border bg-background/50 p-6 no-underline shadow-sm transition-all hover:border-primary/50 hover:shadow-md'
          >
            <div class='flex items-baseline gap-x-3'>
              <h2 class='text-lg font-semibold text-foreground group-hover:text-primary'>
                {node.label}
              </h2>
              <span class='ml-auto text-xs tabular-nums text-muted-foreground'>{node.total} 篇</span>
            </div>
            <p class='text-sm text-muted-foreground line-clamp-2'>
              {categoryDesc(node.path) || `${node.children.length} 个分类`}
            </p>
            {node.children.length > 0 && (
              <div class='mt-1 flex flex-wrap gap-1.5'>
                {node.children.slice(0, 3).map((child) => (
                  <span class='rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground'>
                    {nodes.get(child)?.label}
                  </span>
                ))}
                {node.children.length > 3 && (
                  <span class='rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground'>
                    +{node.children.length - 3}
                  </span>
                )}
              </div>
            )}
          </a>
        ))
      }
    </div>
  </main>
</PageLayout>
