---
/**
 * 单个分类页：/categories/<path>
 *
 * 二级分类以卡片形式列出，本层直属的文章列在下面。
 * 分类由内容路径推导，与 /categories 总览共用同一套工具。
 */
import type { GetStaticPaths } from 'astro'

import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { buildCategoryTree, categoryLabel, docHref, type DocEntry , categoryHref } from '@/utils/docs-categories'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async () => {
  const docs = (await getBlogCollection('docs')) as DocEntry[]
  const nodes = buildCategoryTree(docs)
  return [...nodes.values()].map((node) => ({
    params: { category: node.path },
    props: { path: node.path }
  }))
}

const { path } = Astro.props as { path: string }

const docs = (await getBlogCollection('docs')) as DocEntry[]
const nodes = buildCategoryTree(docs)
const node = nodes.get(path)!

const segments = path.split('/')
const breadcrumbs = segments.map((_, index) => {
  const p = segments.slice(0, index + 1).join('/')
  return { path: p, label: categoryLabel(p) }
})

const meta = {
  title: node.label,
  description: `${node.label}：${node.total} 篇笔记`
}
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10 w-full max-w-5xl mx-auto px-4 pb-20'>
    <nav class='mb-6 flex flex-wrap items-center gap-2 text-sm text-muted-foreground'>
      <a class='no-underline hover:text-primary' href='/categories/'>分类</a>
      {
        breadcrumbs.map((crumb, index) => (
          <>
            <span aria-hidden='true'>/</span>
            {index === breadcrumbs.length - 1 ? (
              <span class='text-foreground'>{crumb.label}</span>
            ) : (
              <a class='no-underline hover:text-primary' href={categoryHref(crumb.path)}>
                {crumb.label}
              </a>
            )}
          </>
        ))
      }
    </nav>

    <header class='mb-8 rounded-2xl border bg-muted/30 px-6 py-6 shadow-sm'>
      <div class='flex items-baseline gap-3'>
        <h1 class='text-3xl font-bold tracking-tight text-foreground'>{node.label}</h1>
        <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
          {node.total} 篇
        </span>
      </div>
      {node.desc && <p class='mt-3 text-sm leading-6 text-muted-foreground'>{node.desc}</p>}
    </header>

    {
      node.children.length > 0 && (
        <section class='mb-10'>
          <h2 class='mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground'>
            子分类
          </h2>
          <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
            {node.children.map((child) => {
              const childNode = nodes.get(child)!
              return (
                <a
                  class='group flex flex-col gap-1 rounded-xl border bg-background/50 p-5 no-underline shadow-sm transition-all hover:border-primary/50 hover:shadow-md'
                  href={categoryHref(childNode.path)}
                >
                  <div class='flex items-baseline gap-3'>
                    <span class='font-medium text-foreground group-hover:text-primary'>
                      {childNode.label}
                    </span>
                    <span class='ml-auto text-xs tabular-nums text-muted-foreground'>
                      {childNode.total > 0 ? `${childNode.total} 篇` : `${childNode.links.length} 个链接`}
                    </span>
                  </div>
                  {childNode.children.length > 0 && (
                    <span class='text-xs text-muted-foreground'>
                      {childNode.children.length} 个子分类
                    </span>
                  )}
                </a>
              )
            })}
          </div>
        </section>
      )
    }

    {
      (node.docs.length > 0 || node.overview) && (
        <section>
          <h2 class='mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground'>
            本层文章
          </h2>
          <ul class='flex list-none flex-col gap-1 p-0'>
            {node.overview && (
              <li>
                <a
                  class='flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-foreground/80 no-underline transition-colors hover:bg-muted/60 hover:text-primary'
                  href={docHref(node.overview)}
                >
                  <span class='size-1.5 shrink-0 rounded-full bg-primary/40' />
                  <span class='line-clamp-2'>{node.overview.data.title}</span>
                </a>
              </li>
            )}
            {node.docs.map((doc) => (
              <li>
                <a
                  class='flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-foreground/80 no-underline transition-colors hover:bg-muted/60 hover:text-primary'
                  href={docHref(doc)}
                >
                  <span class='size-1.5 shrink-0 rounded-full bg-primary/40' />
                  <span class='line-clamp-2'>{doc.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      node.links.length > 0 && (
        <section class='mt-10'>
          <h2 class='mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground'>
            站外资源
          </h2>
          <ul class='flex list-none flex-col gap-1 p-0'>
            {node.links.map((link) => (
              <li>
                <a
                  class='flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-foreground/80 no-underline transition-colors hover:bg-muted/60 hover:text-primary'
                  href={link.href}
                  target='_blank'
                  rel='noopener noreferrer'
                >
                  <span class='size-1.5 shrink-0 rounded-full bg-primary/40' />
                  <span class='line-clamp-2'>{link.title}</span>
                  <span class='ml-auto text-xs text-muted-foreground'>↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      node.children.length === 0 && node.docs.length === 0 && node.links.length === 0 && !node.overview && (
        <p class='text-sm text-muted-foreground'>这个分类下暂时没有内容。</p>
      )
    }
  </main>
</PageLayout>
