---
/**
 * 单个分类页：/categories/<path>
 *
 * 二级分类以卡片形式列出，本层直属的文章列在下面。
 * 分类由内容路径推导，与 /categories 总览共用同一套工具。
 */
import type { GetStaticPaths } from 'astro'

import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import CategorySections from '@/components/categories/CategorySections.astro'
import { blogCategoryEntries } from '@/utils/blog-categories'
import {
  attachBlogPosts,
  buildCategoryTree,
  categoryHref,
  categoryLabel,
  type DocEntry
} from '@/utils/docs-categories'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async () => {
  const docs = (await getBlogCollection('docs')) as DocEntry[]
  const nodes = buildCategoryTree(docs)
  attachBlogPosts(nodes, await blogCategoryEntries())
  return [...nodes.values()].map((node) => ({
    params: { category: node.path },
    props: { path: node.path }
  }))
}

const { path } = Astro.props as { path: string }

const docs = (await getBlogCollection('docs')) as DocEntry[]
const nodes = buildCategoryTree(docs)
attachBlogPosts(nodes, await blogCategoryEntries())
const node = nodes.get(path)!

const segments = path.split('/')
const breadcrumbs = segments.map((_, index) => {
  const p = segments.slice(0, index + 1).join('/')
  return { path: p, label: categoryLabel(p) }
})

const meta = {
  title: node.label,
  description: `${node.label}：${node.total} 篇笔记`
}
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10 w-full max-w-5xl mx-auto px-4 pb-20'>
    <nav class='mb-6 flex flex-wrap items-center gap-2 text-sm text-muted-foreground'>
      <a class='no-underline hover:text-primary' href='/categories/'>分类</a>
      {
        breadcrumbs.map((crumb, index) => (
          <>
            <span aria-hidden='true'>/</span>
            {index === breadcrumbs.length - 1 ? (
              <span class='text-foreground'>{crumb.label}</span>
            ) : (
              <a class='no-underline hover:text-primary' href={categoryHref(crumb.path)}>
                {crumb.label}
              </a>
            )}
          </>
        ))
      }
    </nav>

    <header class='mb-8 rounded-2xl border bg-muted/30 px-6 py-6 shadow-sm'>
      <div class='flex items-baseline gap-3'>
        <h1 class='text-3xl font-bold tracking-tight text-foreground'>{node.label}</h1>
        <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
          {node.total} 篇
        </span>
      </div>
      {node.desc && <p class='mt-3 text-sm leading-6 text-muted-foreground'>{node.desc}</p>}
    </header>

    <CategorySections {node} {nodes} />
  </main>
</PageLayout>
