---
/**
 * 归档：按最近更新时间倒序排列知识库笔记。
 *
 * 日期来自迁移脚本写入的 updatedDate（取自 git 最后一次提交）。
 */
import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import KnowledgeIndexHero from '@/components/KnowledgeIndexHero.astro'
import { docHref, type DocEntry } from '@/utils/docs-categories'

export const prerender = true

const docs = (await getBlogCollection('docs')) as DocEntry[]

const dated = docs
  .map((doc) => ({
    doc,
    date: doc.data.updatedDate ?? doc.data.publishDate
  }))
  .filter((item): item is { doc: DocEntry; date: Date } => item.date instanceof Date)
  .sort((a, b) => b.date.getTime() - a.date.getTime())

// 按 年 → 月 分组
const byYear = new Map<number, Map<number, typeof dated>>()
for (const item of dated) {
  const year = item.date.getFullYear()
  const month = item.date.getMonth()
  if (!byYear.has(year)) byYear.set(year, new Map())
  const months = byYear.get(year)!
  if (!months.has(month)) months.set(month, [])
  months.get(month)!.push(item)
}

const dayFormatter = new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' })
const meta = { title: '归档', description: '按更新时间浏览知识库' }
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10 w-full max-w-4xl mx-auto px-4 pb-20'>
    <KnowledgeIndexHero
      icon='list'
      eyebrow='知识库'
      title='按时间归档'
      description='按最近一次更新的时间倒序排列，方便回顾刚写过的内容。'
      stats={[
        { label: '有日期', value: dated.length },
        { label: '全部', value: docs.length }
      ]}
      statsLabel='归档概览'
      symbol='归档'
    />

    <div class='mt-10 flex flex-col gap-10'>
      {
        [...byYear.entries()].map(([year, months]) => (
          <section>
            <h2 class='mb-4 text-2xl font-bold tracking-tight text-foreground'>{year}</h2>
            <div class='flex flex-col gap-6'>
              {[...months.entries()].map(([month, items]) => (
                <div class='rounded-2xl border bg-background/50 p-5'>
                  <h3 class='mb-3 text-sm font-semibold uppercase tracking-widest text-muted-foreground'>
                    {month + 1} 月
                    <span class='ml-2 font-normal normal-case tracking-normal'>{items.length} 篇</span>
                  </h3>
                  <ul class='flex list-none flex-col gap-1 p-0'>
                    {items.map(({ doc, date }) => (
                      <li>
                        <a
                          class='flex items-baseline gap-3 rounded-lg px-3 py-1.5 text-sm text-foreground/80 no-underline transition-colors hover:bg-muted/60 hover:text-primary'
                          href={docHref(doc)}
                        >
                          <time class='shrink-0 tabular-nums text-xs text-muted-foreground' datetime={date.toISOString()}>
                            {dayFormatter.format(date)}
                          </time>
                          <span class='line-clamp-2'>{doc.data.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</PageLayout>
