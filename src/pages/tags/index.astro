---
/**
 * 标签总览：知识库的扁平索引。
 *
 * 标签来自笔记路径（学科 + 中间各层目录），也可以在 frontmatter 里写 tags 覆盖。
 */
import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import KnowledgeIndexHero from '@/components/KnowledgeIndexHero.astro'
import { categoryLabel } from '@/utils/docs-categories'

export const prerender = true

const docs = await getBlogCollection('docs')
const counts = new Map<string, number>()
for (const doc of docs) {
  for (const tag of new Set(doc.data.tags ?? [])) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1)
  }
}

const tags = [...counts.entries()]
  .map(([name, count]) => ({ name, count, label: categoryLabel(name) }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh'))

const meta = { title: '标签', description: '知识库标签索引' }
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10 w-full max-w-5xl mx-auto px-4 pb-20'>
    <KnowledgeIndexHero
      icon='list'
      eyebrow='知识库'
      title='标签索引'
      description='学科与目录都会成为标签，点击查看对应笔记。'
      stats={[
        { label: '标签', value: tags.length },
        { label: '笔记', value: docs.length }
      ]}
      statsLabel='标签概览'
      symbol='标签'
    />

    <div class='mt-10 flex flex-wrap gap-2'>
      {
        tags.map((tag) => (
          <a
            class='inline-flex items-center gap-2 rounded-full border bg-background/50 px-3.5 py-1.5 text-sm text-foreground/80 no-underline transition-colors hover:border-primary/50 hover:text-primary'
            href={`/tags/${tag.name}`}
          >
            <span>{tag.label}</span>
            <span class='text-xs tabular-nums text-muted-foreground'>{tag.count}</span>
          </a>
        ))
      }
    </div>
  </main>
</PageLayout>
