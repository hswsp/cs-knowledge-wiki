---
/**
 * 单个标签下的笔记列表：/tags/<tag>
 */
import type { GetStaticPaths } from 'astro'

import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { categoryLabel, docHref, type DocEntry } from '@/utils/docs-categories'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async () => {
  const docs = (await getBlogCollection('docs')) as DocEntry[]
  const tags = [...new Set(docs.flatMap((doc) => doc.data.tags ?? []))]
  return tags.map((tag) => ({ params: { tag, page: undefined }, props: { tag } }))
}

const { tag } = Astro.props as { tag: string }

const docs = (await getBlogCollection('docs')) as DocEntry[]
const matched = docs
  .filter((doc) => (doc.data.tags ?? []).includes(tag))
  .sort(
    (a, b) =>
      (a.data.order ?? 999) - (b.data.order ?? 999) || a.data.title.localeCompare(b.data.title, 'zh')
  )

const meta = { title: `标签：${categoryLabel(tag)}`, description: `${matched.length} 篇笔记` }
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10 w-full max-w-4xl mx-auto px-4 pb-20'>
    <nav class='mb-6 text-sm text-muted-foreground'>
      <a class='no-underline hover:text-primary' href='/tags/'>标签</a>
      <span class='mx-2' aria-hidden='true'>/</span>
      <span class='text-foreground'>{categoryLabel(tag)}</span>
    </nav>

    <header class='mb-8 rounded-2xl border bg-muted/30 px-6 py-6 shadow-sm'>
      <div class='flex items-baseline gap-3'>
        <h1 class='text-3xl font-bold tracking-tight text-foreground'>{categoryLabel(tag)}</h1>
        <span class='rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
          {matched.length} 篇
        </span>
      </div>
      <code class='mt-2 inline-block text-xs text-muted-foreground'>{tag}</code>
    </header>

    <ul class='flex list-none flex-col gap-1 p-0'>
      {
        matched.map((doc) => (
          <li>
            <a
              class='flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-foreground/80 no-underline transition-colors hover:bg-muted/60 hover:text-primary'
              href={docHref(doc)}
            >
              <span class='size-1.5 shrink-0 rounded-full bg-primary/40' />
              <span class='line-clamp-2'>{doc.data.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</PageLayout>
