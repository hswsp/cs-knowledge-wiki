---
/**
 * 文档页左侧导航：基于分类数据（与 /categories 同源）。
 *
 * 只渲染当前学科的分类树，避免 900+ 条链接铺满侧边栏。
 */
import { getBlogCollection } from 'astro-pure/server'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import CategoryTree from './CategoryTree.astro'
import { buildCategoryTree, type DocEntry } from '@/utils/docs-categories'

export const prerender = true
export const partial = true

type Props = {
  currentId?: string
  class?: string
}

const { currentId, class: className } = Astro.props

const docs = (await getBlogCollection('docs')) as DocEntry[]
const nodes = buildCategoryTree(docs)

const currentSection = currentId ? currentId.split('/')[0] : undefined
const sectionNode = currentSection ? nodes.get(currentSection) : undefined
---

<nav class={cn('docs-nav not-prose', className)} aria-label='文档导航'>
  {
    sectionNode ? (
      <>
        <a
          class='docs-nav-home'
          href={`/categories/${sectionNode.path}`}
          aria-current={currentId === `${sectionNode.path}/index` ? 'page' : undefined}
        >
          <Icon name='home' class='size-4' />
          <span>{sectionNode.label}</span>
          <span class='docs-nav-count'>{sectionNode.total}</span>
        </a>
        <CategoryTree node={sectionNode} nodes={nodes} currentId={currentId} depth={0} />
      </>
    ) : (
      <a class='docs-nav-home' href='/categories'>
        <Icon name='list' class='size-4' />
        <span>全部分类</span>
      </a>
    )
  }
</nav>

<style>
  .docs-nav {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .docs-nav-home {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    border-bottom: 1px dashed hsl(var(--border));
    border-radius: 0.6rem 0.6rem 0 0;
    padding: 0.35rem 0.55rem 0.5rem;
    color: hsl(var(--foreground) / 0.78);
    text-decoration: none;
  }
  .docs-nav-home:hover {
    color: hsl(var(--foreground));
    background-color: hsl(var(--muted) / 0.6);
  }
  .docs-nav-count {
    margin-left: auto;
    font-size: 0.7rem;
    opacity: 0.55;
    font-variant-numeric: tabular-nums;
  }
</style>
