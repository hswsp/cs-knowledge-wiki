---
/**
 * 分类正文（子分类卡片 + 概览 + 本层文章 + 站外资源）。
 *
 * /categories/<path> 与 /docs/<section> 共用，保证两个入口点进去看到的是同一套
 * 子分类卡片，而不是一边卡片一边折叠列表。
 */
import { categoryHref, docHref, type CategoryNode } from '@/utils/docs-categories'

interface Props {
  node: CategoryNode
  nodes: Map<string, CategoryNode>
}

const { node, nodes } = Astro.props
---

{
  node.children.length > 0 && (
    <section class='mb-10'>
      <h2 class='mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground'>
        子分类
      </h2>
      <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
        {node.children.map((child) => {
          const childNode = nodes.get(child)!
          return (
            <a
              class='group flex flex-col gap-1 rounded-xl border bg-background/50 p-5 no-underline shadow-sm transition-all hover:border-primary/50 hover:shadow-md'
              href={categoryHref(childNode.path)}
            >
              <div class='flex items-baseline gap-3'>
                <span class='font-medium text-foreground group-hover:text-primary'>
                  {childNode.label}
                </span>
                <span class='ml-auto text-xs tabular-nums text-muted-foreground'>
                  {childNode.total > 0
                    ? `${childNode.total} 篇`
                    : childNode.links.length > 0
                      ? `${childNode.links.length} 个链接`
                      : '概览'}
                </span>
              </div>
              {childNode.children.length > 0 && (
                <span class='text-xs text-muted-foreground'>
                  {childNode.children.length} 个子分类
                </span>
              )}
            </a>
          )
        })}
      </div>
    </section>
  )
}

{
  node.overview && (
    <section class='mb-8'>
      <h2 class='mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground'>
        概览
      </h2>
      <a
        class='flex items-center gap-2 rounded-xl border bg-background/50 px-4 py-3 text-sm text-foreground/90 no-underline shadow-sm transition-all hover:border-primary/50 hover:text-primary'
        href={docHref(node.overview)}
      >
        <span class='size-1.5 shrink-0 rounded-full bg-primary' />
        <span class='line-clamp-2 font-medium'>{node.overview.data.title}</span>
      </a>
    </section>
  )
}

{
  node.docs.length + node.posts.length > 0 && (
    <section>
      <h2 class='mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground'>
        本层文章
      </h2>
      <ul class='flex list-none flex-col gap-1 p-0'>
        {node.docs.map((doc) => (
          <li>
            <a
              class='flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-foreground/80 no-underline transition-colors hover:bg-muted/60 hover:text-primary'
              href={docHref(doc)}
            >
              <span class='size-1.5 shrink-0 rounded-full bg-primary/40' />
              <span class='line-clamp-2'>{doc.data.title}</span>
            </a>
          </li>
        ))}
        {node.posts.map((post) => (
          <li>
            <a
              class='flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-foreground/80 no-underline transition-colors hover:bg-muted/60 hover:text-primary'
              href={post.href}
            >
              <span class='size-1.5 shrink-0 rounded-full bg-primary/40' />
              <span class='line-clamp-2'>{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  node.links.length > 0 && (
    <section class='mt-10'>
      <h2 class='mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground'>
        站外资源
      </h2>
      <ul class='flex list-none flex-col gap-1 p-0'>
        {node.links.map((link) => (
          <li>
            <a
              class='flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-foreground/80 no-underline transition-colors hover:bg-muted/60 hover:text-primary'
              href={link.href}
              target='_blank'
              rel='noopener noreferrer'
            >
              <span class='size-1.5 shrink-0 rounded-full bg-primary/40' />
              <span class='line-clamp-2'>{link.title}</span>
              <span class='ml-auto text-xs text-muted-foreground'>↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  node.children.length === 0 &&
    node.docs.length === 0 &&
    node.posts.length === 0 &&
    node.links.length === 0 &&
    !node.overview && <p class='text-sm text-muted-foreground'>这个分类下暂时没有内容。</p>
}
